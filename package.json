{
  "name": "pi-web-search",
  "version": "1.0.0",
  "description": "Two web-search tools for Pi: web_search_exa (primary) and web_search_ddg (fallback via DuckDuckGo Lite through Obscura).",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "web-search",
    "exa",
    "duckduckgo"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "files": [
    "index.ts",
    "lib",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "conformance": "tsx --test tests/conformance/*.conformance.ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "verify": "npm run typecheck && npm run test && npm run conformance"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.20.3",
    "tsx": "^4.19.0",
    "typebox": "^1.3.16",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edisoncks/pi-web-search"
  }
}
